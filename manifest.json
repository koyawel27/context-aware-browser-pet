{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "version": "2.1.0",
  "description": "__MSG_extDescription__",
  "permissions": [
    "storage",
    "webNavigation",
    "offscreen",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/background.ts"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/content.ts"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "assets/icons/logo16.png",
      "48": "assets/icons/logo48.png",
      "128": "assets/icons/logo128.png"
    }
  },
  "icons": {
    "16": "assets/icons/logo16.png",
    "48": "assets/icons/logo48.png",
    "128": "assets/icons/logo128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "assets/icons/*",
        "assets/sounds/*",
        "assets/pets/*",
        "wasm/*",
        "main_world.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://huggingface.co https://*.huggingface.co https://*.hf.co https://*.xethub.hf.co; img-src 'self' data:"
  }
}
